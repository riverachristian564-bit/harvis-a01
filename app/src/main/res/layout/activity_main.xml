<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="14dp" android:background="#03070B" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:text="H.A.R.V.I.S." android:textColor="#EAF8FF" android:textSize="30sp" android:textStyle="bold" android:letterSpacing="0.18" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="MARK I  //  MOBILE INTERFACE" android:textColor="#6B8795" android:textSize="11sp" android:gravity="center" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="CORE // DESCONECTADO" android:textColor="#64D8FF" android:textSize="16sp" android:textStyle="bold" android:gravity="center" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/orb" android:text="◉\n╱╲╱╲╱╲╱╲" android:textColor="#64D8FF" android:textSize="28sp" android:gravity="center" android:padding="12dp" android:layout_width="match_parent" android:layout_height="100dp"/>
<LinearLayout android:id="@+id/settings" android:orientation="vertical" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
<EditText android:id="@+id/baseUrl" android:hint="http://IP-PC:8765" android:textColor="#FFFFFF" android:textColorHint="#71808A" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/token" android:hint="Token de vinculación" android:textColor="#FFFFFF" android:textColorHint="#71808A" android:inputType="textPassword" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/connect" android:text="GUARDAR + CONECTAR" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/config" android:text="CONFIG" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/audio" android:text="AUDIO // AUTO" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content"/>
</LinearLayout>
<ScrollView android:id="@+id/scroll" android:fillViewport="true" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><TextView android:id="@+id/chat" android:textColor="#CFE2EA" android:textSize="15sp" android:textIsSelectable="true" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></ScrollView>
<EditText android:id="@+id/message" android:hint="Escribí a H.A.R.V.I.S..." android:textColor="#FFFFFF" android:textColorHint="#71808A" android:maxLines="3" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/attach" android:text="ADJUNTAR ARCHIVO" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/mic" android:text="HABLAR" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content"/>
<Button android:id="@+id/send" android:text="ENVIAR" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content"/>
<Button android:id="@+id/stop" android:text="STOP" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
</LinearLayout>
</LinearLayout>