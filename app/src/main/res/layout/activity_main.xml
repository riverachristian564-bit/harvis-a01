<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="14dp" android:background="#070B10" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:text="H.A.R.V.I.S." android:textColor="#EAF8FF" android:textSize="28sp" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="DESCONECTADO" android:textColor="#64D8FF" android:gravity="center" android:padding="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/baseUrl" android:hint="http://IP-PC:8765" android:textColor="#FFFFFF" android:hintTextColor="#71808A" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/token" android:hint="Token (si corresponde)" android:textColor="#FFFFFF" android:hintTextColor="#71808A" android:inputType="textPassword" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/connect" android:text="CONECTAR" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<ScrollView android:id="@+id/scroll" android:fillViewport="true" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><TextView android:id="@+id/chat" android:textColor="#D8E6EC" android:textIsSelectable="true" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></ScrollView>
<EditText android:id="@+id/message" android:hint="Escribí a HARVIS..." android:textColor="#FFFFFF" android:hintTextColor="#71808A" android:maxLines="3" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/mic" android:text="MIC" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/send" android:text="ENVIAR" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content"/>
<Button android:id="@+id/stop" android:text="STOP" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
</LinearLayout>
</LinearLayout>
