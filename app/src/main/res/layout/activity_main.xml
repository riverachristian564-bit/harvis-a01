<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="18dp" android:background="#02070B" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:text="H  .  A  .  R  .  V  .  I  .  S  ." android:textColor="#EAFBFF" android:textSize="26sp" android:textStyle="bold" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="MARK I // MOBILE CORE INTERFACE" android:textColor="#4E7D91" android:textSize="10sp" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/orb" android:text="◉\n╱╲╱╲╱╲╱╲" android:textColor="#70E6FF" android:textSize="34sp" android:gravity="center" android:background="#06131B" android:layout_width="match_parent" android:layout_height="128dp"/>
<TextView android:id="@+id/status" android:text="CORE // DESCONECTADO" android:textColor="#70E6FF" android:textSize="14sp" android:textStyle="bold" android:gravity="center" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:id="@+id/settings" android:orientation="vertical" android:visibility="gone" android:background="#071119" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<EditText android:id="@+id/baseUrl" android:hint="CORE // http://IP-PC:8765" android:textColor="#EAFBFF" android:textColorHint="#52707E" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/token" android:hint="TOKEN DE VINCULACIÓN" android:textColor="#EAFBFF" android:textColorHint="#52707E" android:inputType="textPassword" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/connect" android:text="GUARDAR // ENLAZAR" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/config" android:text="CORE" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/audio" android:text="AUDIO // AUTO" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content"/></LinearLayout>
<ScrollView android:id="@+id/scroll" android:fillViewport="true" android:background="#030A0F" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><TextView android:id="@+id/chat" android:textColor="#BBD2DC" android:textSize="14sp" android:lineSpacingExtra="3dp" android:textIsSelectable="true" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></ScrollView>
<EditText android:id="@+id/message" android:hint="COMANDO //" android:textColor="#EAFBFF" android:textColorHint="#52707E" android:background="#071119" android:padding="10dp" android:maxLines="3" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/mic" android:text="◉  VOSK // HABLAR" android:layout_width="0dp" android:layout_weight="3" android:layout_height="wrap_content"/><Button android:id="@+id/send" android:text="ENVIAR" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content"/><Button android:id="@+id/stop" android:text="STOP" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/></LinearLayout>
</LinearLayout>
