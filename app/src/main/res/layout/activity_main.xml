<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="14dp" android:background="#02070B" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content"><LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="HARVIS" android:textColor="#F1FCFF" android:textSize="28sp" android:textStyle="bold" android:letterSpacing="0.12" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:text="RIVERA'S MOTOR ASSISTANT" android:textColor="#6B8795" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout><Button android:id="@+id/config" android:text="CORE" android:layout_width="80dp" android:layout_height="48dp"/></LinearLayout>
<TextView android:id="@+id/status" android:text="MARK I  •  NÚCLEO DESCONECTADO" android:textColor="#6FE6FF" android:textSize="13sp" android:textStyle="bold" android:gravity="center" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<com.riverasmotor.harvisa01.CoreVisualizerView android:id="@+id/coreVisual" android:background="#041019" android:layout_width="match_parent" android:layout_height="220dp"/>
<TextView android:id="@+id/orb" android:text="EN ESPERA" android:textColor="#70E6FF" android:textSize="15sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:id="@+id/settings" android:orientation="vertical" android:visibility="gone" android:background="#071119" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"><EditText android:id="@+id/baseUrl" android:hint="CORE // http://IP-PC:8765" android:textColor="#EAFBFF" android:textColorHint="#52707E" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/token" android:hint="TOKEN DE VINCULACIÓN" android:textColor="#EAFBFF" android:textColorHint="#52707E" android:inputType="textPassword" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content"/><Button android:id="@+id/connect" android:text="GUARDAR // ENLAZAR" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/mode" android:text="MODO TEXTO" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/process" android:text="PROCESO" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/></LinearLayout>
<ScrollView android:id="@+id/processScroll" android:visibility="gone" android:background="#071119" android:layout_width="match_parent" android:layout_height="110dp"><TextView android:id="@+id/processLog" android:text="PROCESO // EN ESPERA" android:textColor="#78B8C9" android:textSize="12sp" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></ScrollView>
<LinearLayout android:id="@+id/textPanel" android:orientation="vertical" android:visibility="gone" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><ScrollView android:id="@+id/scroll" android:fillViewport="true" android:background="#030A0F" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><TextView android:id="@+id/chat" android:textColor="#D3E5EC" android:textSize="14sp" android:lineSpacingExtra="4dp" android:textIsSelectable="true" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></ScrollView><EditText android:id="@+id/message" android:hint="Escribí a HARVIS..." android:textColor="#EAFBFF" android:textColorHint="#52707E" android:background="#071119" android:padding="10dp" android:maxLines="3" android:layout_width="match_parent" android:layout_height="wrap_content"/><Button android:id="@+id/send" android:text="ENVIAR" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
<Space android:id="@+id/voiceSpace" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/audio" android:text="AUDIO" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/mic" android:text="●  HABLAR" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content"/><Button android:id="@+id/stop" android:text="STOP" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/></LinearLayout>
</LinearLayout>